# Actual Budget Configuration
ACTUAL_SERVER_URL=http://actual_server:5006
ACTUAL_PASSWORD=your_actual_server_password
ACTUAL_FILE_PASSWORD=optional_encryption_password_if_e2ee_enabled

# Email Configuration
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password

# Application Settings
CHECK_INTERVAL_SECONDS=300
SEARCH_SENDER_FILTER=notificaciones@bancodechile.cl

# Account Mapping (Email Keyword -> Actual Budget Account Name)
ACCOUNT_MAP_CREDIT=Banco Santander TC
ACCOUNT_MAP_DEBIT=Banco Santander CC
