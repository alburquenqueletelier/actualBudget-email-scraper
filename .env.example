# Actual Budget Configuration
ACTUAL_SERVER_URL=http://actual_server:5006
ACTUAL_PASSWORD=your_actual_server_password
ACTUAL_FILE_PASSWORD=optional_encryption_password_if_e2ee_enabled

# Email Configuration (Gmail OAuth2 / XOAUTH2 — see scripts/gmail_oauth_setup.py)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
EMAIL_USER=your_email@gmail.com
GMAIL_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_oauth_refresh_token

# Application Settings
# HTTP service port inside the container (compose maps host 8899 -> this).
HTTP_PORT=8000
# Required. Secret needed to trigger a scrape via GET / and POST /run.
SCRAPER_TOKEN=generate_a_long_random_string
# Nightly automatic run, 24h HH:MM in the container's local time.
SCRAPER_SCHEDULE_TIME=03:00

# Account mapping + sender filters now live in src/settings.json, not here.
